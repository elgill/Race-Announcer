{
  "name": "race-announcer-angular",
  "productName": "Race Announcer",
  "author": "Chris Gillin",
  "description": "Cross-platform desktop application for announcing race events",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "mac-universal-deploy": "electron-builder -p always -m --universal",
    "win64-deploy": "electron-builder -p always -w --x64",
    "release": "release-it"
  },
  "build": {
    "appId": "dev.gillin.raceannouncer",
    "artifactName": "Race-Announcer-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "Chris Gillin (CPAZW3J38G)"
    },
    "win": {
      "target": "nsis",
      "executableName": "RaceAnnouncer",
      "artifactName": "Race-Announcer-${version}-Setup.${ext}",
      "azureSignOptions": {
        "publisherName": "Christopher Gillin",
        "endpoint": "https://eus.codesigning.azure.net",
        "certificateProfileName": "CGTrustedSignCert",
        "codeSigningAccountName": "CGTrustedSigning"
      }
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "main.js",
      "network-setup.js"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "./build"
    },
    "publish": {
      "provider": "github"
    }
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "file-saver-es": "^2.0.5",
    "idb": "^7.1.1",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lodash": "^4.17.21",
    "lunr": "^2.3.9",
    "papaparse": "^5.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "ws": "^8.17.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@types/file-saver-es": "^2.0.1",
    "@types/jasmine": "~4.3.0",
    "@types/lodash": "^4.14.195",
    "@types/lunr": "^2.3.4",
    "@types/papaparse": "^5.3.7",
    "electron": "^42.11.18",
    "electron-builder": "^26.8.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "release-it": "^19.0.6",
    "typescript": "~6.0.3"
  }
}